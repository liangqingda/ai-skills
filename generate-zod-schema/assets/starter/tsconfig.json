{
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "lib",
    "baseUrl": ".",
    "target": "ES2015",
    "lib": ["ES2023"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "strict": true,
    "declaration": true,
    "sourceMap": true,
    "types": ["node"],
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0"
  },
  "files": ["index.ts"],
  "include": ["common/**/*", "apis/**/*", "types/**/*", "scripts/**/*"]
}
